{
  "info": {
    "name": "DocVer Demo - Scenario 1",
    "description": "알파 시연 시나리오 1: 문서 라이프사이클 전체 흐름\n\nalice가 문서 생성 → 수정 → 승인 요청 → bob이 승인 → 알림 확인 순서로 실행",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "fileId", "value": "demo_file_001"},
    {"key": "author", "value": "alice"},
    {"key": "approver", "value": "bob"}
  ],
  "item": [
    {
      "name": "1. 초기 버전 생성 (alice 업로드)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/versions/initial",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{author}}\",\n  \"fileId\": \"{{fileId}}\",\n  \"size\": 1024,\n  \"mimeType\": \"text/plain\"\n}"
        }
      }
    },
    {
      "name": "2. 문서 수정 (alice 새 버전 추가)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/versions/update",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{author}}\",\n  \"fileId\": \"{{fileId}}\",\n  \"size\": 2048,\n  \"mimeType\": \"text/plain\"\n}"
        }
      }
    },
    {
      "name": "3. alice 본인 알림 확인 (생성/수정 자동 트리거)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notifications?userId={{author}}"
      }
    },
    {
      "name": "4. 승인 요청 (alice → bob)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/approvals/request",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{author}}\",\n  \"fileId\": \"{{fileId}}\",\n  \"comment\": \"검토 부탁드립니다\",\n  \"approvers\": [\"{{approver}}\"]\n}"
        }
      }
    },
    {
      "name": "5. bob 알림 확인 (승인 요청 받음)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notifications?userId={{approver}}&unreadOnly=true"
      }
    },
    {
      "name": "6. bob 안 읽은 알림 카운트",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notifications/unread-count?userId={{approver}}"
      }
    },
    {
      "name": "7. bob 승인 결정",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "url": "{{baseUrl}}/api/approvals/decide",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{approver}}\",\n  \"fileId\": \"{{fileId}}\",\n  \"action\": \"APPROVE\",\n  \"comment\": \"검토 완료, 승인합니다\"\n}"
        }
      }
    },
    {
      "name": "8. alice 최종 결과 알림 확인",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notifications?userId={{author}}&unreadOnly=true"
      }
    }
  ]
}
